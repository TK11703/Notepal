{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "aspire",
            "request": "launch",
            "name": "Aspire: Notepal AppHost",
            "program": "${workspaceFolder}/src/Notepal.AppHost/Notepal.AppHost.csproj",
            "debuggers": {
                // The logged URL carries the dashboard's one-time login token.
                "apphost": {
                    "serverReadyAction": {
                        "action": "openExternally",
                        "pattern": "Login to the dashboard at (https?://\\S+)",
                        "uriFormat": "%s"
                    }
                }
            }
        }
    ]
}