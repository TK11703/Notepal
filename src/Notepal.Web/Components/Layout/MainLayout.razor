@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 gap-2">
            <AuthorizeView>
                <form class="top-search me-auto" role="search" @onsubmit="SearchAsync">
                    <input class="form-control form-control-sm" type="search" placeholder="Search notes…" aria-label="Search notes" @bind="searchText" />
                </form>
            </AuthorizeView>
            <ThemeToggle />
            <LoginDisplay />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? searchText;

    private void SearchAsync()
    {
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            Navigation.NavigateTo($"search?q={Uri.EscapeDataString(searchText.Trim())}");
        }
    }
}
