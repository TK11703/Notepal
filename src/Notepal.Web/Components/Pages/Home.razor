@page "/"
@inherits NotepalComponentBase

<PageTitle>Notepal</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
            <h1 class="h3 mb-0">Welcome back, @(context.User.FindFirst("name")?.Value ?? "there")</h1>
            <a class="btn btn-primary" href="notes/new">＋ New note</a>
        </div>

        <ApiErrorAlert @bind-Message="ErrorMessage" />

        <h2 class="h5">Recent notes</h2>
        @if (recent is null)
        {
            <div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Loading…</span></div>
        }
        else if (recent.Count == 0)
        {
            <p class="text-body-secondary">You have no notes yet. <a href="notes/new">Capture your first page</a>.</p>
        }
        else
        {
            <NoteCardList Notes="recent" />
            <a href="notes">View all notes →</a>
        }
    </Authorized>
    <NotAuthorized>
        <div class="py-5 text-center">
            <h1 class="display-5 fw-bold">📝 Notepal</h1>
            <p class="lead col-lg-8 mx-auto">
                Snap a photo of handwritten notes, upload images, PDFs or Word documents, and let AI turn them
                into searchable, editable text. Your notes are private to your account.
            </p>
            <a class="btn btn-primary btn-lg" href="authentication/login?returnUrl=%2Fnotes">Sign in to get started</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private IReadOnlyList<NoteSummaryDto>? recent;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            await RunAsync(async () => recent = (await Api.ListNotesAsync(1, 6)).Items);
        }
    }
}
