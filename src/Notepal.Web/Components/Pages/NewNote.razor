@page "/notes/new"
@page "/notes/{NoteId:guid}/add-pages"
@attribute [Authorize]
@inherits NotepalComponentBase

<PageTitle>@(Adding ? "Add pages" : "New note") · Notepal</PageTitle>

@if (Adding)
{
    <a class="back-link" href="notes/@NoteId"><Icon Name="chevron-left" /> @(existing?.Title ?? "Back to note")</a>
}
<div class="page-header">
    <div>
        @if (Adding)
        {
            <h1 class="h3">Add pages</h1>
            <p class="page-subtitle">
                New pages are added after the
                @(existing is null ? "existing" : $"{existing.Pages.Count} existing {(existing.Pages.Count == 1 ? "page" : "pages")}") of
                @(existing is null ? "this note" : $"“{existing.Title}”"). AI transcribes them after you save.
            </p>
        }
        else
        {
            <h1 class="h3">New note</h1>
            <p class="page-subtitle">Each file or photo becomes a page. AI transcribes the text after you save. You can add more pages later.</p>
        }
    </div>
</div>

<ApiErrorAlert @bind-Message="ErrorMessage" />

@if (Adding && notFound)
{
    <p>The note does not exist or it belongs to another account. <a href="notes">Back to my notes</a>.</p>
}
else if (Adding && existing is null)
{
    <div class="spinner-border" role="status"><span class="visually-hidden">Loading…</span></div>
}
else if (Adding && MaxPages <= 0)
{
    <div class="alert alert-info d-flex align-items-center gap-2" role="status">
        <Icon Name="info-circle" /> This note already has the maximum of @UploadLimits.MaxFilesPerNote pages. Create a new note for more pages.
    </div>
}
else
{
@if (!Adding)
{
<div class="mb-3" style="max-width: 40rem;">
    <label class="form-label" for="title">Title</label>
    <input id="title" class="form-control" maxlength="200" placeholder="Optional – defaults to the file name" @bind="title" />
</div>

<div class="mb-4" style="max-width: 40rem;">
    <label class="form-label" for="new-note-tags">Tags <span class="text-body-secondary fw-normal">(optional)</span></label>
    <TagEditor @bind-Tags="tags" Suggestions="knownTags" InputId="new-note-tags" />
</div>
}

<div class="segmented mb-3" role="tablist" aria-label="Source">
    <button type="button" role="tab" class="segmented-item @(source == Source.Upload ? "active" : null)" aria-selected="@(source == Source.Upload ? "true" : "false")" @onclick="() => source = Source.Upload">
        <Icon Name="cloud-arrow-up" /> Upload files
    </button>
    <button type="button" role="tab" class="segmented-item @(source == Source.Camera ? "active" : null)" aria-selected="@(source == Source.Camera ? "true" : "false")" @onclick="() => source = Source.Camera">
        <Icon Name="camera-fill" /> Camera
    </button>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <fieldset disabled="@(preparingFiles || Busy)">
        <div class="@(source == Source.Upload ? null : "d-none")">
            <div class="dropzone">
                <span class="feature-icon"><Icon Name="cloud-arrow-up" /></span>
                <label class="fw-semibold text-body" for="files">Drop files here or click to browse</label>
                <span class="small">Images (JPEG, PNG, WebP, GIF), PDF or Word (.docx) – up to @(UploadLimits.MaxFileBytes / 1024 / 1024) MB each</span>
                <InputFile id="files" multiple accept="@UploadLimits.AcceptAttribute" OnChange="OnFilesSelectedAsync" />
            </div>
        </div>

        <div class="card card-body @(source == Source.Camera ? null : "d-none")">
            <CameraCapture @ref="camera" OnCaptured="OnCapturedAsync" />
            <hr />
            <label class="form-label" for="device-camera">Or use your device's camera app</label>
            <InputFile id="device-camera" class="form-control" accept="image/*" capture="environment" OnChange="OnFilesSelectedAsync" />
        </div>
        </fieldset>
    </div>

    <div class="col-lg-5">
        <div class="card card-body">
        <h2 class="h6 d-flex justify-content-between">@(Adding ? "New pages" : "Pages") <span class="text-body-secondary fw-normal">@items.Count / @MaxPages</span></h2>
        <div role="status" aria-live="polite" aria-atomic="true">
            @if (preparingFiles)
            {
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="spinner-border spinner-border-sm flex-shrink-0" aria-hidden="true"></span>
                    <div class="small">
                        <div>Preparing file @preparingFileNumber of @preparingFileCount: @preparingFileName</div>
                        <div class="text-body-secondary">Reading files and creating previews. @(Adding ? "Pages are added" : "The note is saved") only after you click @(Adding ? "Add pages" : "Save note").</div>
                    </div>
                </div>
            }
        </div>
        @if (items.Count == 0 && !preparingFiles)
        {
            <p class="text-body-secondary small">
                Nothing added yet. Each file or photo becomes a page of the note, in this order@(Adding ? $", starting at page {NextPageNumber}" : null).
            </p>
        }
        else if (items.Count > 0)
        {
            <ol class="list-group list-group-numbered mb-3">
                @foreach (var item in items)
                {
                    <li class="list-group-item d-flex align-items-center gap-2">
                        @if (item.ThumbnailUrl is not null)
                        {
                            <img class="upload-thumb" src="@item.ThumbnailUrl" alt="" />
                        }
                        else
                        {
                            <span class="upload-thumb d-inline-flex align-items-center justify-content-center fs-4"><Icon Name="file-earmark-text" /></span>
                        }
                        <div class="flex-grow-1 text-truncate">
                            <div class="text-truncate">@item.FileName</div>
                            <small class="text-body-secondary">@FormatSize(item.Data.Length)</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(preparingFiles || Busy)" aria-label="Remove @item.FileName" title="Remove" @onclick="() => RemoveAsync(item)"><Icon Name="x-lg" /></button>
                    </li>
                }
            </ol>
        }

        <button type="button" class="btn btn-primary w-100" disabled="@(items.Count == 0 || Busy || preparingFiles)" @onclick="SaveAsync">
            @if (Busy)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                <span>Uploading…</span>
            }
            else
            {
                <span class="d-inline-flex align-items-center gap-1"><Icon Name="check2" /> @(Adding ? $"Add {items.Count} {(items.Count == 1 ? "page" : "pages")}" : "Save note")</span>
            }
        </button>
        @if (Adding)
        {
            <a class="btn btn-link w-100 mt-1 text-body-secondary" href="notes/@NoteId">Cancel</a>
        }
        </div>
    </div>
</div>
}

@code {
    private enum Source { Upload, Camera }

    private sealed record PendingFile(string FileName, string ContentType, byte[] Data, string? ThumbnailUrl, string? ObjectUrl);

    private readonly List<PendingFile> items = [];
    private CameraCapture? camera;
    private Source source = Source.Upload;
    private string? title;
    private IReadOnlyList<string> tags = [];
    private IReadOnlyList<TagDto> knownTags = [];
    private int photoCounter;
    private NoteDto? existing;
    private bool notFound;
    private bool preparingFiles;
    private int preparingFileNumber;
    private int preparingFileCount;
    private string? preparingFileName;

    /// <summary>Set when adding pages to an existing note instead of creating a new one.</summary>
    [Parameter] public Guid? NoteId { get; set; }

    private bool Adding => NoteId is not null;

    /// <summary>How many pages can still be added: the per-note limit minus the pages the note already has.</summary>
    private int MaxPages => UploadLimits.MaxFilesPerNote - (existing?.Pages.Count ?? 0);

    private int NextPageNumber => (existing?.Pages.Count > 0 ? existing.Pages.Max(p => p.PageNumber) : 0) + 1;

    protected override Task OnInitializedAsync() => NoteId is { } id
        ? RunAsync(async () =>
        {
            existing = await Api.GetNoteAsync(id);
            notFound = existing is null;
        })
        : RunAsync(async () => knownTags = await Api.GetTagsAsync());

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        if (preparingFiles || Busy)
        {
            return;
        }

        ErrorMessage = null;
        if (e.FileCount > UploadLimits.MaxFilesPerNote)
        {
            ErrorMessage = LimitMessage;
            return;
        }

        var problems = new List<string>();
        preparingFiles = true;
        preparingFileNumber = 0;
        preparingFileCount = e.FileCount;
        try
        {
            foreach (var file in e.GetMultipleFiles(UploadLimits.MaxFilesPerNote))
            {
                if (items.Count >= MaxPages)
                {
                    problems.Add(LimitMessage);
                    break;
                }

                preparingFileNumber++;
                preparingFileName = file.Name;
                StateHasChanged();

                var extension = Path.GetExtension(file.Name);
                if (!UploadLimits.AllowedTypes.TryGetValue(extension, out var contentType))
                {
                    problems.Add($"'{file.Name}' is not a supported file type.");
                    continue;
                }

                if (file.Size == 0 || file.Size > UploadLimits.MaxFileBytes)
                {
                    problems.Add($"'{file.Name}' must be smaller than {UploadLimits.MaxFileBytes / 1024 / 1024} MB.");
                    continue;
                }

                try
                {
                    // Read immediately: browser file references become invalid once the input's selection changes.
                    await using var stream = file.OpenReadStream(UploadLimits.MaxFileBytes);
                    using var buffer = new MemoryStream();
                    await stream.CopyToAsync(buffer);

                    string? thumbnail = null;
                    if (contentType.StartsWith("image/", StringComparison.Ordinal))
                    {
                        var resized = await file.RequestImageFileAsync("image/jpeg", 128, 128);
                        await using var thumbStream = resized.OpenReadStream(UploadLimits.MaxFileBytes);
                        using var thumbBuffer = new MemoryStream();
                        await thumbStream.CopyToAsync(thumbBuffer);
                        thumbnail = $"data:image/jpeg;base64,{Convert.ToBase64String(thumbBuffer.ToArray())}";
                    }

                    items.Add(new PendingFile(file.Name, contentType, buffer.ToArray(), thumbnail, null));
                }
                catch (Exception ex) when (ex is IOException or InvalidOperationException or JSException)
                {
                    problems.Add($"Could not read '{file.Name}': {ex.Message}");
                }
            }
        }
        finally
        {
            preparingFiles = false;
            preparingFileName = null;
            if (problems.Count > 0)
            {
                ErrorMessage = string.Join(" ", problems.Distinct());
            }
            StateHasChanged();
        }
    }

    private async Task OnCapturedAsync(CameraCapture.CapturedPhoto photo)
    {
        if (items.Count >= MaxPages)
        {
            ErrorMessage = LimitMessage;
            await camera!.ReleaseAsync(photo.ObjectUrl);
            return;
        }

        photoCounter++;
        items.Add(new PendingFile($"photo-{DateTime.Now:yyyyMMdd-HHmmss}-{photoCounter}.jpg", "image/jpeg", photo.Data, photo.ObjectUrl, photo.ObjectUrl));
    }

    private async Task RemoveAsync(PendingFile item)
    {
        items.Remove(item);
        if (item.ObjectUrl is not null && camera is not null)
        {
            await camera.ReleaseAsync(item.ObjectUrl);
        }
    }

    private string LimitMessage => Adding
        ? $"A note can contain at most {UploadLimits.MaxFilesPerNote} pages, so you can add {MaxPages} more to this note."
        : $"A note can contain at most {UploadLimits.MaxFilesPerNote} pages.";

    private async Task SaveAsync()
    {
        if (preparingFiles || Busy || items.Count == 0)
        {
            return;
        }

        NoteDto? saved = null;
        var uploads = items.Select(i => new UploadItem(i.FileName, i.ContentType, i.Data)).ToList();
        var firstNewPage = NextPageNumber;
        var ok = await RunAsync(async () => saved = NoteId is { } id
            ? await Api.AddPagesAsync(id, uploads)
            : await Api.CreateNoteAsync(title, tags, uploads));

        if (ok && saved is not null)
        {
            Navigation.NavigateTo(Adding ? $"notes/{saved.Id}?page={firstNewPage}" : $"notes/{saved.Id}");
        }
    }

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.0} MB" : $"{Math.Max(1, bytes / 1024)} KB";
}
