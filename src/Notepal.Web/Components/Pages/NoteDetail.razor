@page "/notes/{NoteId:guid}"
@attribute [Authorize]
@inherits NotepalComponentBase
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>@(note?.Title ?? "Note") · Notepal</PageTitle>

<ApiErrorAlert @bind-Message="ErrorMessage" />

@if (notFound)
{
    <h1 class="h3">Note not found</h1>
    <p>The note does not exist, or it belongs to another account and hasn’t been shared with you. <a href="notes">Back to my notes</a>.</p>
}
else if (note is null)
{
    <div class="spinner-border" role="status"><span class="visually-hidden">Loading…</span></div>
}
else
{
    @if (IsOwner)
    {
        <a class="back-link" href="notes"><Icon Name="chevron-left" /> My notes</a>
    }
    else
    {
        <a class="back-link" href="shared"><Icon Name="chevron-left" /> Shared with me</a>
    }
    <div class="page-header mb-3">
        <div class="min-w-0 flex-grow-1">
            @if (editingTitle)
            {
                <form class="d-flex gap-2" style="max-width: 36rem;" @onsubmit="SaveTitleAsync">
                    <input class="form-control" maxlength="200" aria-label="Note title" @bind="titleDraft" />
                    <button class="btn btn-primary" type="submit">Save</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="() => editingTitle = false">Cancel</button>
                </form>
            }
            else
            {
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <h1 class="h3 mb-0 text-break">@note.Title</h1>
                    @if (CanEdit)
                    {
                        <button class="btn btn-sm btn-link text-body-secondary p-1" type="button" title="Rename note" @onclick="StartTitleEdit">
                            <Icon Name="pencil" /><span class="visually-hidden">Rename</span>
                        </button>
                    }
                    <StatusBadge Status="note.Status" />
                </div>
            }
            <div class="small text-body-secondary mt-1 d-flex flex-wrap align-items-center gap-1">
                <Icon Name="clock" /> Created @note.CreatedAt.LocalDateTime.ToString("g") · Updated @note.UpdatedAt.LocalDateTime.ToString("g")
                · @note.Pages.Count @(note.Pages.Count == 1 ? "page" : "pages")
            </div>
            @if (!IsOwner)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2 small">
                    <span class="status-pill status-info"><Icon Name="people" /> Shared with you@(note.SharedBy is null ? null : $" by {note.SharedBy}")</span>
                    <RoleBadge Role="note.Role" />
                </div>
            }
            @if (editingTags)
            {
                <div class="card card-body mt-3 note-tags-editor" style="max-width: 40rem;">
                    <label class="form-label fw-semibold" for="note-tags">Tags</label>
                    <TagEditor @bind-Tags="tagsDraft" Suggestions="knownTags" InputId="note-tags" />
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-sm btn-primary" type="button" disabled="@Busy" @onclick="SaveTagsAsync">Save tags</button>
                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => editingTags = false">Cancel</button>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                    @* Tag links filter the owner's own notes, so they are only links for the owner. *@
                    <TagChips Tags="note.Tags" HrefFor="@(IsOwner ? TagChips.NotesHref : null)" />
                    @if (CanEdit)
                    {
                        <button class="btn btn-sm btn-link text-body-secondary p-0 d-inline-flex align-items-center gap-1 text-decoration-none" type="button" @onclick="StartTagEditAsync">
                            <Icon Name="@(note.Tags.Count == 0 ? "tag" : "pencil")" /> @(note.Tags.Count == 0 ? "Add tags" : "Edit tags")
                        </button>
                    }
                </div>
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (IsOwner)
            {
                <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" type="button" title="@ShareTitle" @onclick="() => sharing = true">
                    <Icon Name="share" /> Share
                    @if (note.ShareCount > 0)
                    {
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis">@note.ShareCount<span class="visually-hidden"> @(note.ShareCount == 1 ? "person" : "people")</span></span>
                    }
                </button>
            }
            @if (CanEdit && note.Pages.Count < UploadLimits.MaxFilesPerNote)
            {
                <a class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" href="notes/@note.Id/add-pages" title="Add more pages to the end of this note">
                    <Icon Name="file-earmark-plus" /> Add pages
                </a>
            }
            @* Only the owner can delete a note. *@
            @if (IsOwner && confirmDelete)
            {
                <button class="btn btn-sm btn-danger" type="button" @onclick="DeleteAsync">Confirm delete</button>
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => confirmDelete = false">Cancel</button>
            }
            else if (IsOwner)
            {
                <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" type="button" @onclick="() => confirmDelete = true">
                    <Icon Name="trash3" /> Delete
                </button>
            }
        </div>
    </div>

    @if (sharing)
    {
        <ShareDialog NoteId="note.Id" Title="@note.Title" OnClose="() => sharing = false" SharesChanged="OnSharesChanged" />
    }

    @if (movingPage is not null)
    {
        <MovePageDialog NoteId="note.Id" PageId="movingPage.Id" PageNumber="movingPage.PageNumber" OnClose="() => movingPage = null" Moved="OnPageMoved" />
    }

    @if (movedTo is not null)
    {
        <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2" role="status">
            <Icon Name="check2" />
            <span>Page moved to <a class="alert-link" href="notes/@movedTo.Value.Id?page=@movedTo.Value.PageNumber">@movedTo.Value.Title</a>.</span>
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => movedTo = null"></button>
        </div>
    }

    @if (current is not null)
    {
        <div class="note-toolbar">
            <div class="d-flex flex-wrap align-items-center gap-2">
            @if (note.Pages.Count > 1)
            {
                <nav class="page-chips" aria-label="Pages">
                    <button class="page-chip" type="button" disabled="@(current.PageNumber <= 1)" @onclick="() => SelectPage(current.PageNumber - 1)" title="Previous page">
                        <Icon Name="chevron-left" /><span class="visually-hidden">Previous page</span>
                    </button>
                    @foreach (var p in note.Pages)
                    {
                        <button class="page-chip @(p.Id == current.Id ? "active" : null)" type="button" @onclick="() => SelectPage(p.PageNumber)"
                                aria-current="@(p.Id == current.Id ? "page" : null)" title="@PageChipTitle(p)">
                            @p.PageNumber
                            @if (IsDirty(p))
                            {
                                <span class="dirty-dot" aria-hidden="true"></span>
                            }
                        </button>
                    }
                    <button class="page-chip" type="button" disabled="@(current.PageNumber >= note.Pages.Count)" @onclick="() => SelectPage(current.PageNumber + 1)" title="Next page">
                        <Icon Name="chevron-right" /><span class="visually-hidden">Next page</span>
                    </button>
                </nav>

                @if (CanEdit)
                {
                    var selected = current;
                    <div class="page-actions" role="group" aria-label="Page @selected.PageNumber">
                        <button class="page-chip" type="button" disabled="@(Busy || selected.PageNumber <= 1)" @onclick="() => MovePageAsync(selected, selected.PageNumber - 1)" title="Move page @selected.PageNumber earlier">
                            <Icon Name="arrow-left" /><span class="visually-hidden">Move page @selected.PageNumber earlier</span>
                        </button>
                        <button class="page-chip" type="button" disabled="@(Busy || selected.PageNumber >= note.Pages.Count)" @onclick="() => MovePageAsync(selected, selected.PageNumber + 1)" title="Move page @selected.PageNumber later">
                            <Icon Name="arrow-right" /><span class="visually-hidden">Move page @selected.PageNumber later</span>
                        </button>
                        @* Pages belong to the note's owner, so only the owner can move them to another note. *@
                        @if (IsOwner)
                        {
                            <button class="page-chip" type="button" disabled="@Busy" @onclick="() => movingPage = selected" title="Move page @selected.PageNumber to another note">
                                <Icon Name="box-arrow-right" /><span class="visually-hidden">Move page @selected.PageNumber to another note</span>
                            </button>
                        }
                        @if (confirmDeletePage)
                        {
                            <button class="btn btn-sm btn-danger" type="button" disabled="@Busy" @onclick="() => DeletePageAsync(selected)">Delete page @selected.PageNumber</button>
                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => confirmDeletePage = false">Cancel</button>
                        }
                        else
                        {
                            <button class="page-chip page-chip-danger" type="button" disabled="@Busy" @onclick="() => confirmDeletePage = true" title="Delete page @selected.PageNumber">
                                <Icon Name="trash3" /><span class="visually-hidden">Delete page @selected.PageNumber</span>
                            </button>
                        }
                    </div>
                }
            }
            </div>

            <div class="segmented" role="tablist" aria-label="View">
                @foreach (var t in Enum.GetValues<ViewTab>())
                {
                    <button type="button" role="tab" id="tab-@t" class="segmented-item @(tab == t ? "active" : null)" aria-selected="@(tab == t ? "true" : "false")"
                            aria-controls="note-view" title="@TabLabel(t)" @onclick="() => SetTabAsync(t)">
                        <Icon Name="@TabIcon(t)" /> <span class="d-none d-sm-inline">@TabLabel(t)</span>
                        <span class="visually-hidden d-sm-none">@TabLabel(t)</span>
                    </button>
                }
            </div>
        </div>

        <div id="note-view" role="tabpanel" aria-labelledby="tab-@tab">
            @if (tab == ViewTab.Original)
            {
                <div class="card">@RenderOriginal(current)</div>
            }
            else if (tab == ViewTab.Notes)
            {
                <div class="card">@RenderEditor(current)</div>
            }
            else
            {
                <div class="row g-3 split-view">
                    <div class="col-lg-6"><div class="card pane-original">@RenderOriginal(current)</div></div>
                    <div class="col-lg-6"><div class="card">@RenderEditor(current)</div></div>
                </div>
            }
        </div>
    }
}

@code {
    private enum ViewTab { Original, Notes, SideBySide }

    [Parameter] public Guid NoteId { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }

    private readonly Dictionary<Guid, string> drafts = [];
    private readonly CancellationTokenSource disposed = new();
    private NoteDto? note;
    private PageDto? current;
    private ViewTab tab = ViewTab.SideBySide;
    private bool notFound;
    private bool editingTitle;
    private bool editingTags;
    private IReadOnlyList<string> tagsDraft = [];
    private IReadOnlyList<TagDto> knownTags = [];
    private bool confirmDelete;
    private bool confirmDeletePage;
    private bool sharing;
    private PageDto? movingPage;
    private (Guid Id, string Title, int PageNumber)? movedTo;
    private bool polling;
    private string? titleDraft;
    private int editorVersion;

    private const string ViewPreferenceKey = "note-view";

    private bool IsOwner => note?.Role is null or NoteRole.Owner;

    private bool CanEdit => note?.Role is null or NoteRole.Owner or NoteRole.Contributor;

    private string ShareTitle => note?.ShareCount switch
    {
        null or 0 => "Share this note with people in your organization",
        1 => "Shared with 1 person",
        var n => $"Shared with {n} people",
    };

    private static string TabLabel(ViewTab t) => t switch
    {
        ViewTab.Original => "Original",
        ViewTab.Notes => "Notes",
        _ => "Side by side",
    };

    private static string TabIcon(ViewTab t) => t switch
    {
        ViewTab.Original => "image",
        ViewTab.Notes => "file-earmark-text",
        _ => "layout-split",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("notepalPrefs.get", disposed.Token, ViewPreferenceKey);
                if (Enum.TryParse<ViewTab>(saved, out var preferred) && Enum.IsDefined(preferred) && preferred != tab)
                {
                    tab = preferred;
                    StateHasChanged();
                }
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
            {
                // The preference is optional; keep the default view.
            }
        }
    }

    private async Task SetTabAsync(ViewTab value)
    {
        tab = value;
        try
        {
            await JS.InvokeVoidAsync("notepalPrefs.set", disposed.Token, ViewPreferenceKey, value.ToString());
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (note?.Id != NoteId)
        {
            note = null;
            movedTo = null;
            drafts.Clear();
            await RunAsync(async () => SetNote(await Api.GetNoteAsync(NoteId, disposed.Token)));
        }

        SelectPage(PageNumber ?? current?.PageNumber ?? 1);
    }

    private void SetNote(NoteDto? value)
    {
        notFound = value is null;
        note = value;
        if (note is not null)
        {
            current = note.Pages.FirstOrDefault(p => p.Id == current?.Id) ?? note.Pages.FirstOrDefault();
            if (IsProcessing(note.Status) && !polling)
            {
                _ = PollAsync();
            }
        }
    }

    private void SelectPage(int number)
    {
        confirmDeletePage = false;
        current = note?.Pages.FirstOrDefault(p => p.PageNumber == number) ?? note?.Pages.FirstOrDefault();
    }

    private static bool IsProcessing(ProcessingStatus status) => status is ProcessingStatus.Pending or ProcessingStatus.Processing;

    private async Task PollAsync()
    {
        polling = true;
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (await timer.WaitForNextTickAsync(disposed.Token))
            {
                var latest = await Api.GetNoteAsync(NoteId, disposed.Token);
                await InvokeAsync(() =>
                {
                    SetNote(latest);
                    StateHasChanged();
                });

                if (latest is null || !IsProcessing(latest.Status))
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            // Polling is best effort; the user can refresh the page.
        }
        finally
        {
            polling = false;
        }
    }

    private void Discard(PageDto page)
    {
        drafts.Remove(page.Id);
        editorVersion++;
    }

    private string GetText(PageDto page) => drafts.TryGetValue(page.Id, out var draft) ? draft : page.Text ?? string.Empty;

    private void SetText(PageDto page, string? value) => drafts[page.Id] = value ?? string.Empty;

    private bool IsDirty(PageDto page) => drafts.TryGetValue(page.Id, out var draft) && draft != (page.Text ?? string.Empty);

    private void ReplacePage(PageDto updated)
    {
        if (note is null)
        {
            return;
        }

        var pages = note.Pages.Select(p => p.Id == updated.Id ? updated : p).ToList();
        note = note with { Pages = pages, Status = Aggregate(pages) };
        if (current?.Id == updated.Id)
        {
            current = updated;
        }
    }

    private static ProcessingStatus Aggregate(IReadOnlyList<PageDto> pages) =>
        pages.Any(p => IsProcessing(p.Status)) ? ProcessingStatus.Processing
        : pages.Any(p => p.Status == ProcessingStatus.Failed) ? ProcessingStatus.Failed
        : ProcessingStatus.Completed;

    private async Task SaveTextAsync(PageDto page, string text)
    {
        if (await RunAsync(async () => ReplacePage(await Api.UpdatePageTextAsync(NoteId, page.Id, text))))
        {
            drafts.Remove(page.Id);
            editorVersion++;
        }
    }

    private async Task ReprocessAsync(PageDto page)
    {
        if (await RunAsync(async () => ReplacePage(await Api.ReprocessPageAsync(NoteId, page.Id))) && !polling)
        {
            _ = PollAsync();
        }
    }

    private async Task MovePageAsync(PageDto page, int pageNumber)
    {
        // SetNote keeps the moved page selected, since it tracks the current page by id.
        await RunAsync(async () => SetNote(await Api.MovePageAsync(NoteId, page.Id, pageNumber, disposed.Token)));
    }

    private async Task DeletePageAsync(PageDto page)
    {
        confirmDeletePage = false;
        if (await RunAsync(async () => SetNote(await Api.DeletePageAsync(NoteId, page.Id, disposed.Token))))
        {
            drafts.Remove(page.Id);
            SelectPage(Math.Min(page.PageNumber, note?.Pages.Count ?? 1));
        }
    }

    private void OnPageMoved((NoteDto Source, NoteSummaryDto Target) result)
    {
        var page = movingPage!;
        movingPage = null;
        drafts.Remove(page.Id);
        movedTo = (result.Target.Id, result.Target.Title, result.Target.PageCount + 1);
        SetNote(result.Source);
        SelectPage(Math.Min(page.PageNumber, note?.Pages.Count ?? 1));
    }

    private void OnSharesChanged(int count)
    {
        if (note is not null)
        {
            note = note with { ShareCount = count };
        }
    }

    private void StartTitleEdit()
    {
        titleDraft = note?.Title;
        editingTitle = true;
    }

    private async Task SaveTitleAsync()
    {
        if (string.IsNullOrWhiteSpace(titleDraft))
        {
            return;
        }

        if (await RunAsync(async () => note = await Api.RenameNoteAsync(NoteId, titleDraft)))
        {
            editingTitle = false;
            SelectPage(current?.PageNumber ?? 1);
        }
    }

    private async Task StartTagEditAsync()
    {
        tagsDraft = note?.Tags ?? [];
        editingTags = true;
        await RunAsync(async () => knownTags = await Api.GetTagsAsync(disposed.Token));
    }

    private async Task SaveTagsAsync()
    {
        if (await RunAsync(async () => note = await Api.UpdateNoteTagsAsync(NoteId, tagsDraft, disposed.Token)))
        {
            editingTags = false;
            SelectPage(current?.PageNumber ?? 1);
        }
    }

    private async Task DeleteAsync()
    {
        if (await RunAsync(() => Api.DeleteNoteAsync(NoteId)))
        {
            Navigation.NavigateTo("notes");
        }
    }

    private static string FileUrl(Guid noteId, PageDto pg) =>
        $"files/notes/{noteId}/pages/{pg.Id}";

    private RenderFragment RenderOriginal(PageDto pg) => __builder =>
    {
        <div class="pane">
            <div class="pane-header">
                <h2 class="pane-title"><Icon Name="image" /> Original</h2>
                <span class="small text-body-secondary text-truncate" style="max-width: 60%;" title="@pg.FileName">@pg.FileName · @FormatSize(pg.SizeBytes)</span>
                <a class="btn btn-sm btn-outline-secondary ms-auto d-inline-flex align-items-center gap-1" href="@FileUrl(NoteId, pg)" download="@pg.FileName" title="Download original">
                    <Icon Name="file-earmark-arrow-down" /><span class="visually-hidden">Download original</span>
                </a>
            </div>
            <div class="pane-body">
                <div class="original-viewer p-3">
                    @if (pg.ContentType.StartsWith("image/", StringComparison.Ordinal))
                    {
                        <a href="@FileUrl(NoteId, pg)" target="_blank" rel="noopener" title="Open full size">
                            <img src="@FileUrl(NoteId, pg)" alt="Original of page @pg.PageNumber: @pg.FileName" loading="lazy" />
                        </a>
                    }
                    else if (pg.ContentType == "application/pdf")
                    {
                        <iframe src="@FileUrl(NoteId, pg)" title="Original PDF: @pg.FileName"></iframe>
                    }
                    else
                    {
                        <div class="text-center p-5">
                            <span class="feature-icon mb-3"><Icon Name="file-earmark-text" /></span>
                            <p class="mb-1 fw-semibold">@pg.FileName</p>
                            <p class="small text-body-secondary">Word documents cannot be previewed in the browser.</p>
                            <a class="btn btn-outline-primary" href="@FileUrl(NoteId, pg)" download="@pg.FileName">Download original</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    };

    private RenderFragment RenderEditor(PageDto pg) => __builder =>
    {
        <div class="pane">
            <div class="pane-header">
                <h2 class="pane-title"><Icon Name="file-earmark-text" /> Notes</h2>
                <StatusBadge Status="pg.Status" />
                @if (pg.IsEdited)
                {
                    <span class="status-pill status-warning" title="This page contains your corrections"><Icon Name="pencil" /> Edited</span>
                }
                @if (IsDirty(pg))
                {
                    <span class="status-pill status-primary">Unsaved changes</span>
                }
                @if (CanEdit)
                {
                    <button class="btn btn-sm btn-outline-secondary ms-auto d-inline-flex align-items-center gap-1" type="button" disabled="@(Busy || IsProcessing(pg.Status))" @onclick="() => ReprocessAsync(pg)"
                            title="Run text extraction again. Your saved corrections are kept.">
                        <Icon Name="arrow-repeat" /> <span class="d-none d-md-inline">Re-run extraction</span>
                        <span class="visually-hidden d-md-none">Re-run extraction</span>
                    </button>
                }
                else
                {
                    <span class="status-pill status-secondary ms-auto" title="You have read-only access to this note"><Icon Name="eye" /> Read only</span>
                }
            </div>
            <div class="pane-body">
                @if (pg.Status == ProcessingStatus.Failed && !string.IsNullOrEmpty(pg.Error))
                {
                    <div class="alert alert-warning small d-flex gap-2"><Icon Name="exclamation-triangle" Class="mt-1 flex-shrink-0" /> <div class="page-error">@pg.Error @(CanEdit ? "You can still type the notes yourself below." : null)</div></div>
                }

                @if (IsProcessing(pg.Status) && string.IsNullOrEmpty(pg.Text))
                {
                    <div class="d-flex flex-column align-items-center justify-content-center gap-2 text-body-secondary p-5 text-center flex-grow-1">
                        <span class="feature-icon"><Icon Name="stars" /></span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
                            Reading the page with AI… this usually takes a few seconds.
                        </div>
                    </div>
                }
                else
                {
                    <label class="visually-hidden" for="editor-@pg.Id">Notes text for page @pg.PageNumber</label>
                    <textarea @key="(pg.Id, editorVersion)" id="editor-@pg.Id" class="form-control notes-editor" spellcheck="true" readonly="@(!CanEdit)"
                              value="@GetText(pg)" @onchange="e => SetText(pg, e.Value?.ToString())"></textarea>
                    @if (CanEdit)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button class="btn btn-primary d-inline-flex align-items-center gap-1" type="button" disabled="@(Busy || !IsDirty(pg))" @onclick="() => SaveTextAsync(pg, GetText(pg))">
                                <Icon Name="check2" /> Save corrections
                            </button>
                            <button class="btn btn-outline-secondary" type="button" disabled="@(!IsDirty(pg))" @onclick="() => Discard(pg)">Discard changes</button>
                            @if (pg.IsEdited && pg.ExtractedText is not null)
                            {
                                <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-1" type="button" disabled="@Busy" @onclick="() => SaveTextAsync(pg, pg.ExtractedText)">
                                    <Icon Name="arrow-counterclockwise" /> Revert to AI text
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    };

    private string PageChipTitle(PageDto p) => IsDirty(p) ? $"Page {p.PageNumber} (unsaved changes)" : $"Page {p.PageNumber}";

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.0} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    public void Dispose()
    {
        disposed.Cancel();
        disposed.Dispose();
    }
}
