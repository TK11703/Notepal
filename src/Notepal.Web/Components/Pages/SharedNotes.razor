@page "/shared"
@attribute [Authorize]
@inherits NotepalComponentBase

<PageTitle>Shared notes · Notepal</PageTitle>

<div class="page-header">
    <div>
        <h1 class="h3">Shared notes</h1>
        <p class="page-subtitle">Notes other people shared with you, and notes you shared with others.</p>
    </div>
</div>

<div class="segmented mb-4" role="tablist" aria-label="Shared notes">
    <a role="tab" class="segmented-item text-decoration-none @(ByMe ? null : "active")" aria-selected="@(ByMe ? "false" : "true")" href="shared">
        <Icon Name="people" /> Shared with me
        @if (withMeTotal is { } w)
        {
            <span class="tag-count">@w</span>
        }
    </a>
    <a role="tab" class="segmented-item text-decoration-none @(ByMe ? "active" : null)" aria-selected="@(ByMe ? "true" : "false")" href="shared?view=by-me">
        <Icon Name="share" /> Shared by me
        @if (byMeTotal is { } b)
        {
            <span class="tag-count">@b</span>
        }
    </a>
</div>

<ApiErrorAlert @bind-Message="ErrorMessage" />

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-success d-flex align-items-center gap-2 py-2" role="status">
        <Icon Name="check2" /> <span class="flex-grow-1">@statusMessage</span>
        <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => statusMessage = null"></button>
    </div>
}

@if (result is null)
{
    <div class="spinner-border" role="status"><span class="visually-hidden">Loading…</span></div>
}
else if (result.Total == 0)
{
    <div class="empty-state">
        <span class="feature-icon"><Icon Name="@(ByMe ? "share" : "people")" /></span>
        @if (ByMe)
        {
            <p class="mb-3">You haven’t shared any notes yet. Open a note and choose <strong>Share</strong> to give people in your organization access.</p>
            <a class="btn btn-outline-secondary" href="notes">Go to my notes</a>
        }
        else
        {
            <p class="mb-0">Nothing has been shared with you yet. When someone shares a note with you, it appears here.</p>
        }
    </div>
}
else
{
    @if (!ByMe)
    {
        <div class="shared-select-bar @(selected.Count > 0 ? "has-selection" : null)">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="select-all-shared"
                       checked="@AllSelected" disabled="@Busy" @onchange="ToggleAll" />
                <label class="form-check-label small" for="select-all-shared">
                    @(selected.Count == 0 ? "Select all on this page" : $"{selected.Count} selected")
                </label>
            </div>
            @if (confirmLeave && selected.Count > 0)
            {
                <span class="small text-body-secondary flex-grow-1">
                    Leave @NotesCount(selected.Count)? You lose access until the owner shares @(selected.Count == 1 ? "it" : "them") again.
                </span>
                <button class="btn btn-sm btn-danger d-inline-flex align-items-center gap-1" type="button" disabled="@Busy" @onclick="LeaveSelectedAsync">
                    <Icon Name="box-arrow-left" /> Leave
                </button>
                <button class="btn btn-sm btn-outline-secondary" type="button" disabled="@Busy" @onclick="() => confirmLeave = false">Cancel</button>
            }
            else
            {
                <span class="flex-grow-1"></span>
                @if (selected.Count > 0)
                {
                    <button class="btn btn-sm btn-link text-decoration-none" type="button" @onclick="ClearSelection">Clear</button>
                }
                <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" type="button"
                        disabled="@(Busy || selected.Count == 0)" @onclick="() => confirmLeave = true"
                        title="Remove your access to the selected notes">
                    <Icon Name="box-arrow-left" /> Leave@(selected.Count > 0 ? $" ({selected.Count})" : null)
                </button>
            }
        </div>
    }
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-4">
        @foreach (var item in result.Items)
        {
            var note = item.Note;
            var isSelected = selected.Contains(note.Id);
            <div class="col" @key="note.Id">
                <div class="card h-100 note-card position-relative @(isSelected ? "note-card-selected" : null)">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            @if (!ByMe)
                            {
                                <input class="form-check-input note-select flex-shrink-0" type="checkbox" checked="@isSelected" disabled="@Busy"
                                       aria-label="Select @note.Title" @onchange="() => Toggle(note.Id)" />
                            }
                            <h3 class="h6 card-title mb-0 text-truncate flex-grow-1">
                                <a class="stretched-link text-decoration-none text-body" href="notes/@note.Id">@note.Title</a>
                            </h3>
                            <StatusBadge Status="note.Status" />
                        </div>
                        <p class="card-text small note-preview mb-3 flex-grow-1">@(string.IsNullOrWhiteSpace(note.Preview) ? "No text yet." : note.Preview)</p>
                        <TagChips Tags="note.Tags" Class="mb-3" />
                        @if (ByMe)
                        {
                            <div class="shared-people mb-3" title="@string.Join(", ", item.SharedWith.Select(Describe))">
                                <span class="avatar-stack" aria-hidden="true">
                                    @foreach (var person in item.SharedWith.Take(MaxAvatars))
                                    {
                                        <span class="avatar avatar-sm">@ShareDialog.Initials(person.DisplayName ?? person.Email)</span>
                                    }
                                </span>
                                <span class="small text-body-secondary text-truncate">Shared with @PeopleSummary(item.SharedWith)</span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3 small">
                                <span class="text-body-secondary text-truncate">Shared by <strong class="text-body">@(item.SharedBy ?? "someone")</strong></span>
                                <RoleBadge Role="item.Role" />
                            </div>
                        }
                        <div class="small text-body-secondary d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><Icon Name="clock" /> @note.UpdatedAt.LocalDateTime.ToString("g")</span>
                            <span class="d-inline-flex align-items-center gap-1"><Icon Name="file-earmark-text" /> @note.PageCount @(note.PageCount == 1 ? "page" : "pages")</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <Pager Page="result.Page" PageSize="result.PageSize" Total="result.Total" PageChanged="LoadAsync" />
}

@code {
    private const int PageSize = 12;
    private const int MaxAvatars = 4;
    private PagedResult<SharedNoteDto>? result;
    private int? withMeTotal;
    private int? byMeTotal;
    private readonly HashSet<Guid> selected = [];
    private bool confirmLeave;
    private string? statusMessage;

    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }

    private bool ByMe => string.Equals(View, "by-me", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        result = null;
        statusMessage = null;
        await LoadAsync(1);
    }

    private Task LoadAsync(int page) => RunAsync(async () =>
    {
        selected.Clear();
        confirmLeave = false;
        // Load the selected list, plus the size of the other one for its tab.
        var withMe = Api.ListSharedWithMeAsync(ByMe ? 1 : page, ByMe ? 1 : PageSize);
        var byMe = Api.ListSharedByMeAsync(ByMe ? page : 1, ByMe ? PageSize : 1);
        await Task.WhenAll(withMe, byMe);
        withMeTotal = withMe.Result.Total;
        byMeTotal = byMe.Result.Total;
        result = ByMe ? byMe.Result : withMe.Result;
    });

    private bool AllSelected => result is { Items.Count: > 0 } r && r.Items.All(i => selected.Contains(i.Note.Id));

    private void Toggle(Guid noteId)
    {
        if (!selected.Remove(noteId))
        {
            selected.Add(noteId);
        }

        confirmLeave = false;
    }

    private void ToggleAll()
    {
        if (AllSelected)
        {
            selected.Clear();
        }
        else if (result is not null)
        {
            selected.UnionWith(result.Items.Select(i => i.Note.Id));
        }

        confirmLeave = false;
    }

    private void ClearSelection()
    {
        selected.Clear();
        confirmLeave = false;
    }

    private async Task LeaveSelectedAsync()
    {
        if (result is null || selected.Count == 0)
        {
            return;
        }

        var ids = selected.ToList();
        var page = result.Page;
        LeaveSharedNotesResult? left = null;
        if (!await RunAsync(async () => left = await Api.LeaveSharedNotesAsync(ids)))
        {
            return;
        }

        // Stay on the same page unless it is now empty.
        var remaining = result.Total - left!.Left;
        var lastPage = Math.Max(1, (remaining + PageSize - 1) / PageSize);
        await LoadAsync(Math.Min(page, lastPage));
        statusMessage = $"You left {NotesCount(left.Left)}.";
    }

    private static string NotesCount(int count) => count == 1 ? "1 note" : $"{count} notes";

    private static string Describe(NoteShareDto share) =>
        $"{share.DisplayName ?? share.Email} ({share.Permission})";

    private static string PeopleSummary(IReadOnlyList<NoteShareDto> people)
    {
        var first = people.Count == 0 ? "nobody" : people[0].DisplayName ?? people[0].Email;
        return people.Count switch
        {
            <= 1 => first,
            2 => $"{first} and 1 other",
            _ => $"{first} and {people.Count - 1} others",
        };
    }
}
