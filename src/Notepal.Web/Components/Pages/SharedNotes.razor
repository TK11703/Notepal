@page "/shared"
@attribute [Authorize]
@inherits NotepalComponentBase

<PageTitle>Shared notes · Notepal</PageTitle>

<div class="page-header">
    <div>
        <h1 class="h3">Shared notes</h1>
        <p class="page-subtitle">Notes other people shared with you, and notes you shared with others.</p>
    </div>
</div>

<div class="segmented mb-4" role="tablist" aria-label="Shared notes">
    <a role="tab" class="segmented-item text-decoration-none @(ByMe ? null : "active")" aria-selected="@(ByMe ? "false" : "true")" href="shared">
        <Icon Name="people" /> Shared with me
        @if (withMeTotal is { } w)
        {
            <span class="tag-count">@w</span>
        }
    </a>
    <a role="tab" class="segmented-item text-decoration-none @(ByMe ? "active" : null)" aria-selected="@(ByMe ? "true" : "false")" href="shared?view=by-me">
        <Icon Name="share" /> Shared by me
        @if (byMeTotal is { } b)
        {
            <span class="tag-count">@b</span>
        }
    </a>
</div>

<ApiErrorAlert @bind-Message="ErrorMessage" />

@if (result is null)
{
    <div class="spinner-border" role="status"><span class="visually-hidden">Loading…</span></div>
}
else if (result.Total == 0)
{
    <div class="empty-state">
        <span class="feature-icon"><Icon Name="@(ByMe ? "share" : "people")" /></span>
        @if (ByMe)
        {
            <p class="mb-3">You haven’t shared any notes yet. Open a note and choose <strong>Share</strong> to give people in your organisation access.</p>
            <a class="btn btn-outline-secondary" href="notes">Go to my notes</a>
        }
        else
        {
            <p class="mb-0">Nothing has been shared with you yet. When someone shares a note with you, it appears here.</p>
        }
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-4">
        @foreach (var item in result.Items)
        {
            var note = item.Note;
            <div class="col" @key="note.Id">
                <a class="card h-100 note-card text-decoration-none text-body" href="notes/@note.Id">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h3 class="h6 card-title mb-0 text-truncate">@note.Title</h3>
                            <StatusBadge Status="note.Status" />
                        </div>
                        <p class="card-text small note-preview mb-3 flex-grow-1">@(string.IsNullOrWhiteSpace(note.Preview) ? "No text yet." : note.Preview)</p>
                        <TagChips Tags="note.Tags" Class="mb-3" />
                        @if (ByMe)
                        {
                            <div class="shared-people mb-3" title="@string.Join(", ", item.SharedWith.Select(Describe))">
                                <span class="avatar-stack" aria-hidden="true">
                                    @foreach (var person in item.SharedWith.Take(MaxAvatars))
                                    {
                                        <span class="avatar avatar-sm">@ShareDialog.Initials(person.DisplayName ?? person.Email)</span>
                                    }
                                </span>
                                <span class="small text-body-secondary text-truncate">Shared with @PeopleSummary(item.SharedWith)</span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3 small">
                                <span class="text-body-secondary text-truncate">Shared by <strong class="text-body">@(item.SharedBy ?? "someone")</strong></span>
                                <RoleBadge Role="item.Role" />
                            </div>
                        }
                        <div class="small text-body-secondary d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><Icon Name="clock" /> @note.UpdatedAt.LocalDateTime.ToString("g")</span>
                            <span class="d-inline-flex align-items-center gap-1"><Icon Name="file-earmark-text" /> @note.PageCount @(note.PageCount == 1 ? "page" : "pages")</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
    <Pager Page="result.Page" PageSize="result.PageSize" Total="result.Total" PageChanged="LoadAsync" />
}

@code {
    private const int PageSize = 12;
    private const int MaxAvatars = 4;
    private PagedResult<SharedNoteDto>? result;
    private int? withMeTotal;
    private int? byMeTotal;

    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }

    private bool ByMe => string.Equals(View, "by-me", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        result = null;
        await LoadAsync(1);
    }

    private Task LoadAsync(int page) => RunAsync(async () =>
    {
        // Load the selected list, plus the size of the other one for its tab.
        var withMe = Api.ListSharedWithMeAsync(ByMe ? 1 : page, ByMe ? 1 : PageSize);
        var byMe = Api.ListSharedByMeAsync(ByMe ? page : 1, ByMe ? PageSize : 1);
        await Task.WhenAll(withMe, byMe);
        withMeTotal = withMe.Result.Total;
        byMeTotal = byMe.Result.Total;
        result = ByMe ? byMe.Result : withMe.Result;
    });

    private static string Describe(NoteShareDto share) =>
        $"{share.DisplayName ?? share.Email} ({share.Permission})";

    private static string PeopleSummary(IReadOnlyList<NoteShareDto> people)
    {
        var first = people.Count == 0 ? "nobody" : people[0].DisplayName ?? people[0].Email;
        return people.Count switch
        {
            <= 1 => first,
            2 => $"{first} and 1 other",
            _ => $"{first} and {people.Count - 1} others",
        };
    }
}
