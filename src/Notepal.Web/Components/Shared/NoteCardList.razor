<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-3">
    @foreach (var note in Notes)
    {
        <div class="col">
            <a class="card h-100 note-card text-decoration-none text-body" href="notes/@note.Id">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h3 class="h6 card-title mb-1 text-truncate">@note.Title</h3>
                        <StatusBadge Status="note.Status" />
                    </div>
                    <div class="small text-body-secondary mb-2">
                        @note.UpdatedAt.LocalDateTime.ToString("g") · @note.PageCount @(note.PageCount == 1 ? "page" : "pages")
                    </div>
                    <p class="card-text small note-preview mb-0">@(string.IsNullOrWhiteSpace(note.Preview) ? "No text yet." : note.Preview)</p>
                </div>
            </a>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NoteSummaryDto> Notes { get; set; } = [];
}
