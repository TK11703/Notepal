@if (TotalPages > 1)
{
    <nav class="d-flex align-items-center justify-content-between gap-2" aria-label="Pagination">
        <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" @onclick="() => PageChanged.InvokeAsync(Page - 1)" disabled="@(Page <= 1)">
            <Icon Name="chevron-left" /> Previous
        </button>
        <span class="small text-body-secondary">Page @Page of @TotalPages</span>
        <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" @onclick="() => PageChanged.InvokeAsync(Page + 1)" disabled="@(Page >= TotalPages)">
            Next <Icon Name="chevron-right" />
        </button>
    </nav>
}

@code {
    [Parameter] public int Page { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private int TotalPages => PageSize <= 0 ? 0 : (Total + PageSize - 1) / PageSize;
}
