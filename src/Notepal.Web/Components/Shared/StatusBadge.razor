<span class="status-pill @CssClass">
    @if (Status == ProcessingStatus.Processing)
    {
        <span class="spinner-grow spinner-grow-sm" aria-hidden="true"></span>
    }
    else
    {
        <span class="status-dot" aria-hidden="true"></span>
    }
    @Text
</span>

@code {
    [Parameter, EditorRequired] public ProcessingStatus Status { get; set; }

    private string CssClass => Status switch
    {
        ProcessingStatus.Completed => "status-success",
        ProcessingStatus.Failed => "status-danger",
        ProcessingStatus.Processing => "status-info",
        _ => "status-secondary",
    };

    private string Text => Status switch
    {
        ProcessingStatus.Completed => "Ready",
        ProcessingStatus.Failed => "Failed",
        ProcessingStatus.Processing => "Reading…",
        _ => "Queued",
    };
}
