@inject IJSRuntime JS
@inject ILogger<ThemeToggle> Logger
@implements IAsyncDisposable

<div class="segmented segmented-sm" role="radiogroup" aria-label="Color theme">
    @foreach (var m in Modes)
    {
        <button type="button" role="radio" class="segmented-item @(mode == m.Value ? "active" : null)" aria-checked="@(mode == m.Value ? "true" : "false")"
                title="@m.Label theme" disabled="@(module is null)" @onclick="() => SetAsync(m.Value)">
            <Icon Name="@m.Icon" />
            <span class="visually-hidden">@m.Label</span>
        </button>
    }
</div>

@code {
    private static readonly (string Value, string Label, string Icon)[] Modes =
    [
        ("light", "Light", "sun-fill"),
        ("dark", "Dark", "moon-stars-fill"),
        ("auto", "Auto (system)", "circle-half"),
    ];

    private string mode = "auto";
    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme.js");
            mode = await module.InvokeAsync<string>("initialize");
            StateHasChanged();
        }
    }

    private async Task SetAsync(string next)
    {
        if (module is not null)
        {
            mode = await module.InvokeAsync<string>("set", next);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException)
        {
            Logger.LogDebug("Theme listener cleanup was interrupted by circuit disconnection");
        }
        finally
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                Logger.LogDebug("Theme module disposal was interrupted by circuit disconnection");
            }
        }
    }
}
