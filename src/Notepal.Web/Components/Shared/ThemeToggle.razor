@inject IJSRuntime JS

<div class="segmented segmented-sm" role="radiogroup" aria-label="Colour theme">
    @foreach (var m in Modes)
    {
        <button type="button" role="radio" class="segmented-item @(mode == m.Value ? "active" : null)" aria-checked="@(mode == m.Value ? "true" : "false")"
                title="@m.Label theme" @onclick="() => SetAsync(m.Value)">
            <Icon Name="@m.Icon" />
            <span class="visually-hidden">@m.Label</span>
        </button>
    }
</div>

@code {
    private static readonly (string Value, string Label, string Icon)[] Modes =
    [
        ("light", "Light", "sun-fill"),
        ("dark", "Dark", "moon-stars-fill"),
        ("auto", "Auto (system)", "circle-half"),
    ];

    private string mode = "auto";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            mode = await JS.InvokeAsync<string>("notepalTheme.get");
            StateHasChanged();
        }
    }

    private async Task SetAsync(string next)
    {
        mode = await JS.InvokeAsync<string>("notepalTheme.set", next);
    }
}
